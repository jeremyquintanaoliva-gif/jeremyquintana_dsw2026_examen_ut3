meta {
  name: 04.5 PATCH title invalido + description valida
  type: http
  seq: 5
}

patch {
  url: http://localhost:4000/api/v1/documents/11111111-1111-4111-8111-111111111111
  body: json
  auth: none
}

body:json {
  {
    "title": "",
    "description": "Esta descripcion NO debe guardarse"
  }
}

assert {
  res.status: eq 400
  res.body.error: eq INVALID_TITLE
}
